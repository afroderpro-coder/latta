# 1. Supabase Database & Auth (Unchanged Primary Backend)
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 2. Cloudinary Media Storage (25 GB Free Storage & Videos, No Credit Card Required)
# Cloudinary Console -> Cloud Name & Settings -> Upload -> Upload presets (Unsigned)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# 3. Firebase Cloud Storage (Optional alternative)

# 3. Payments (Razorpay)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# 4. WhatsApp Cloud API Notifications
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# 5. Admin Controller Access
WEB_CONTROLLER_PASSWORD=""

